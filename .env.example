# --- Discovery (pick one; Serper is the default) ---
SERPER_API_KEY=
BRAVE_API_KEY=
DAILY_SEARCH_QUERIES=6        # searches per daily run (keeps API cost low)
PIPELINE_HOUR_PHT=7           # daily search/check/score/draft runs after this hour, Philippine time

# --- Dashboard (Railway service) ---
ADMIN_PASSWORD=               # 12+ characters; login is user "admin"
BASE_URL=                     # public URL for unsubscribe links; Railway's RAILWAY_PUBLIC_DOMAIN is used if empty

# --- Email via Resend (sending stays OFF until EMAIL_SENDING_ENABLED=true) ---
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=        # whsec_... from the Resend webhook you create for /webhooks/resend
UNSUB_SECRET=                 # 16+ random characters; signs unsubscribe links
SENDER_FROM_EMAIL=            # on a verified Resend domain, ideally a subdomain like hello@mail.mindlabfuture-ai.com
EMAIL_DAILY_CAP=20            # hard daily limit
EMAIL_SPACING_SECONDS=120     # max pause between sends (random 60..this)

# --- Who the messages come from ---
SENDER_NAME=Mark
SENDER_COMPANY=MindLab Future AI
SENDER_EMAIL=support@mindlabfuture-ai.com     # reply-to
SENDER_ADDRESS=Corporate Tower 2, BGC, Taguig City, Philippines

# Optional: Meta Graph API token with Page Public Content Access (needs Meta app review)
META_GRAPH_TOKEN=

# Optional: override the logo shown in emails (defaults to the one on mindlabfuture-ai.com)
LOGO_URL=

# POPLoad prospect sequence: max emails per day (separate from EMAIL_DAILY_CAP and FOLLOWUP_DAILY_CAP)
PROSPECT_DAILY_CAP=10
# Daily web searches that look for more POPLoad prospects (needs SERPER_API_KEY or BRAVE_API_KEY)
PROSPECT_SEARCH_QUERIES=4

# Demo sites on Netlify (set in Railway, never in chat)
NETLIFY_AUTH_TOKEN=
# NETLIFY_ACCOUNT_SLUG=your-team-slug
# DEMO_DOMAIN=mindlabfuture-ai.com
# DEMO_DAYS=30

# Assistant: daily brief and critical alerts go here (your own address), chat needs the API key
OWNER_EMAIL=
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=60
# BRIEF_HOUR_PHT=8

# Support inbox agent (moved from the sms-compliance repo). Off until INBOX_ENABLED=true. Stop the old agent first.
INBOX_ENABLED=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_USER=support@mindlabfuture-ai.com
MAIL_PASSWORD=
MAIL_FROM_NAME=MindLab Future AI
POLL_SECONDS=60
AGENT_MODEL=claude-sonnet-5-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_TOKEN=
REPLY_MODE=draft
AUTO_CONFIDENCE=0.85
NURTURE_DAYS=2,5,10

# Google Places discovery (optional; Places API (New) enabled in Google Cloud)
GOOGLE_PLACES_API_KEY=
PLACES_DAILY_QUERIES=3
PLACES_MAX_PAGES=2

# Free OpenStreetMap discovery (on by default)
OSM_DISCOVERY=true
OSM_DAILY_QUERIES=3
OVERPASS_URL=
