# --- Discovery (pick one; Serper is the default) ---
SERPER_API_KEY=
BRAVE_API_KEY=
DAILY_SEARCH_QUERIES=6        # searches per daily run (keeps API cost low)
PIPELINE_HOUR_PHT=7           # daily search/check/score/draft runs after this hour, Philippine time

# --- Dashboard (Railway service) ---
ADMIN_PASSWORD=               # 12+ characters; login is user "admin"
BASE_URL=                     # public URL for unsubscribe links; Railway's RAILWAY_PUBLIC_DOMAIN is used if empty

# --- Email via Resend (sending stays OFF until EMAIL_SENDING_ENABLED=true) ---
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=        # whsec_... from the Resend webhook you create for /webhooks/resend
UNSUB_SECRET=                 # 16+ random characters; signs unsubscribe links
SENDER_FROM_EMAIL=            # on a verified Resend domain, ideally a subdomain like hello@mail.mindlabfuture-ai.com
EMAIL_DAILY_CAP=20            # hard daily limit
EMAIL_SPACING_SECONDS=120     # max pause between sends (random 60..this)

# --- Who the messages come from ---
SENDER_NAME=Mark
SENDER_COMPANY=MindLab Future AI
SENDER_EMAIL=support@mindlabfuture-ai.com     # reply-to
SENDER_ADDRESS=Corporate Tower 2, BGC, Taguig City, Philippines

# Optional: Meta Graph API token with Page Public Content Access (needs Meta app review)
META_GRAPH_TOKEN=
